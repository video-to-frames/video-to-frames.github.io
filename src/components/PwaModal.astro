---
import { DEFAULT_LOCALE, tServer, type LocaleCode } from '../i18n/ssr';

interface Props {
  locale?: LocaleCode;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
---

<div
  id="vtf-pwa-modal"
  class="modal-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="vtf-pwa-modal-title"
  hidden
>
  <div class="modal-card">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:0.75rem;margin-bottom:0.75rem;">
      <span class="privacy-badge" style="padding:0.35rem 0.75rem;font-size:0.8rem;">
        <span class="privacy-dot" aria-hidden="true"></span>
        <span data-i18n="pwa.offlineReadyBadge">{tServer(locale, 'pwa.offlineReadyBadge')}</span>
      </span>
      <button
        id="vtf-pwa-modal-close"
        type="button"
        class="btn-ghost btn-sm"
        data-i18n="pwa.closeModal"
      >
        {tServer(locale, 'pwa.closeModal')}
      </button>
    </div>

    <h2 id="vtf-pwa-modal-title" style="margin:0 0 0.45rem;font-size:1.4rem;font-weight:850;" data-i18n="pwa.modalTitle">
      {tServer(locale, 'pwa.modalTitle')}
    </h2>
    <p style="margin:0 0 1rem;color:var(--text-secondary);font-size:0.98rem;" data-i18n="pwa.modalSubtitle">
      {tServer(locale, 'pwa.modalSubtitle')}
    </p>

    <div id="vtf-pwa-installed-msg" class="alert-banner alert-warning" hidden>
      <span data-i18n="pwa.modalAlreadyInstalled">{tServer(locale, 'pwa.modalAlreadyInstalled')}</span>
    </div>

    <div id="vtf-pwa-instructions" style="display:grid;gap:0.75rem;">
      <div class="info-card" style="padding:0.95rem;">
        <p style="margin:0;font-size:0.92rem;" data-i18n="pwa.modalDesktopHint">
          {tServer(locale, 'pwa.modalDesktopHint')}
        </p>
      </div>
      <div class="info-card" style="padding:0.95rem;">
        <p style="margin:0;font-size:0.92rem;" data-i18n="pwa.modalIosHint">
          {tServer(locale, 'pwa.modalIosHint')}
        </p>
      </div>
    </div>
  </div>
</div>
