---
import { DEFAULT_LOCALE, getLocalizedHref, LANGUAGES, tServer, type LocaleCode } from '../i18n/ssr';
import BrandIcon from './BrandIcon.astro';

interface Props {
  locale?: LocaleCode;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const currentLangMeta = LANGUAGES.find((l) => l.code === locale) ?? LANGUAGES[0];
const homeHref = getLocalizedHref(locale, '/');
---

<header class="site-header">
  <div class="container navbar-inner">
    <a
      href={homeHref}
      class="brand-link"
      data-i18n-aria="nav.homeAria"
      aria-label={tServer(locale, 'nav.homeAria')}
    >
      <BrandIcon size={38} />
      <span class="brand-title-text" data-i18n="nav.brandTitle">
        {tServer(locale, 'nav.brandTitle')}
      </span>
    </a>

    <nav
      class="nav-actions"
      data-i18n-aria="nav.primaryNavAria"
      aria-label={tServer(locale, 'nav.primaryNavAria')}
    >
      <!-- Language Selector Dropdown (8 Languages) -->
      <div class="lang-dropdown-wrap">
        <button
          id="vtf-lang-trigger"
          type="button"
          class="nav-btn"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-controls="vtf-lang-menu"
          data-i18n-aria="nav.languageAria"
          data-i18n-title="nav.languageAria"
          aria-label={tServer(locale, 'nav.languageAria')}
          title={tServer(locale, 'nav.languageAria')}
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M3.6 9h16.8M3.6 15h16.8" />
            <path d="M12 3a13.5 13.5 0 0 0 0 18M12 3a13.5 13.5 0 0 1 0 18" />
          </svg>
          <span id="vtf-lang-current-label" class="desktop-label">{currentLangMeta.nativeName}</span>
          <svg class="lang-chevron" style="width:16px;height:16px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </button>

        <div
          id="vtf-lang-menu"
          class="lang-menu"
          role="listbox"
          aria-labelledby="vtf-lang-trigger"
          tabindex="-1"
          hidden
        >
          {LANGUAGES.map((lang) => (
            <button
              type="button"
              role="option"
              class="lang-option"
              data-lang-option={lang.code}
              aria-selected={lang.code === locale ? 'true' : 'false'}
            >
              <span>{lang.nativeName}</span>
              <span class="lang-code-pill mono-num">{lang.shortLabel}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Light / Dark Mode Toggle -->
      <button
        id="vtf-theme-toggle"
        type="button"
        class="nav-icon-btn"
        aria-label={tServer(locale, 'nav.themeToDark')}
        title={tServer(locale, 'nav.themeToDark')}
      >
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>

      <!-- Add to Home Screen (PWA Offline Install Trigger) -->
      <button
        id="vtf-pwa-install"
        type="button"
        class="nav-btn"
        data-i18n-aria="nav.installApp"
        data-i18n-title="nav.installApp"
        aria-label={tServer(locale, 'nav.installApp')}
        title={tServer(locale, 'nav.installApp')}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="6" y="2.5" width="12" height="19" rx="2.5" />
          <path d="M12 8v6m0 0-2.5-2.5M12 14l2.5-2.5M10 18h4" />
        </svg>
        <span id="vtf-pwa-install-label" class="desktop-label" data-i18n="nav.installApp">
          {tServer(locale, 'nav.installApp')}
        </span>
      </button>

      <!-- GitHub Repository Link (Icon Only) -->
      <a
        href="https://github.com/video-to-frames/video-to-frames.github.io"
        target="_blank"
        rel="noopener noreferrer"
        class="nav-icon-btn"
        data-i18n-aria="nav.githubAria"
        data-i18n-title="nav.githubAria"
        aria-label={tServer(locale, 'nav.githubAria')}
        title={tServer(locale, 'nav.githubAria')}
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.86 8.35 6.84 9.7.5.1.68-.22.68-.49 0-.24-.01-1.05-.01-1.91-2.78.62-3.37-1.21-3.37-1.21-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.36-2.22-.26-4.55-1.14-4.55-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05A9.36 9.36 0 0 1 12 6.84c.85 0 1.71.12 2.51.35 1.91-1.32 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.81 0 .27.18.6.69.49A10.22 10.22 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z" />
        </svg>
      </a>

      <!-- Support the Developer CTA Button -->
      <a
        href="https://kisharadilshan.gumroad.com/coffee"
        target="_blank"
        rel="noopener noreferrer"
        class="nav-btn nav-btn-accent"
        data-i18n-aria="nav.supportAria"
        data-i18n-title="nav.supportAria"
        aria-label={tServer(locale, 'nav.supportAria')}
        title={tServer(locale, 'nav.supportAria')}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17 8h1.5a3.5 3.5 0 0 1 0 7H17" />
          <path d="M4 8h13v7a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V8Z" />
          <path d="M8 2.5v2M12 2.5v2" />
        </svg>
        <span class="desktop-label" data-i18n="nav.supportCta">
          {tServer(locale, 'nav.supportCta')}
        </span>
      </a>
    </nav>
  </div>
</header>
