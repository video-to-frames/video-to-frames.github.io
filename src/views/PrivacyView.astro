---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getLocalizedHref, tServer, type LocaleCode } from '../i18n/ssr';

interface Props {
  locale?: LocaleCode;
}

const { locale = 'en' } = Astro.props;
const SITE = 'https://video-to-frames.github.io';
const homeUrl = new URL(getLocalizedHref(locale, '/'), SITE).toString();
const pageUrl = new URL(getLocalizedHref(locale, '/privacy/'), SITE).toString();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: tServer(locale, 'pages.privacyTitle'),
    description: tServer(locale, 'meta.privacyDescription'),
    url: pageUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: tServer(locale, 'nav.breadcrumbHome'),
        item: homeUrl,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: tServer(locale, 'nav.privacy'),
        item: pageUrl,
      },
    ],
  },
];
---

<BaseLayout
  locale={locale}
  routePath="/privacy/"
  title={tServer(locale, 'meta.privacyTitle')}
  description={tServer(locale, 'meta.privacyDescription')}
  metaTitleKey="meta.privacyTitle"
  metaDescKey="meta.privacyDescription"
  jsonLd={jsonLd}
>
  <section class="page-hero" aria-labelledby="vtf-privacy-title">
    <div class="container">
      <Breadcrumbs locale={locale} currentKey="nav.privacy" />
      <h1 id="vtf-privacy-title" data-i18n="pages.privacyTitle">{tServer(locale, 'pages.privacyTitle')}</h1>
      <p data-i18n="pages.privacySubtitle">{tServer(locale, 'pages.privacySubtitle')}</p>
    </div>
  </section>

  <section class="container" aria-labelledby="vtf-privacy-sec1-title">
    <div class="prose-stack">
      <article class="prose-card">
        <h2 id="vtf-privacy-sec1-title" data-i18n="pages.privacySec1Title">{tServer(locale, 'pages.privacySec1Title')}</h2>
        <p data-i18n="pages.privacySec1Body">{tServer(locale, 'pages.privacySec1Body')}</p>
      </article>

      <article class="prose-card">
        <h2 data-i18n="pages.privacySec2Title">{tServer(locale, 'pages.privacySec2Title')}</h2>
        <p data-i18n="pages.privacySec2Body">{tServer(locale, 'pages.privacySec2Body')}</p>
      </article>

      <article class="prose-card">
        <h2 data-i18n="pages.privacySec3Title">{tServer(locale, 'pages.privacySec3Title')}</h2>
        <p data-i18n="pages.privacySec3Body">{tServer(locale, 'pages.privacySec3Body')}</p>
      </article>

      <div style="text-align:center;padding-top:0.5rem;">
        <a href={getLocalizedHref(locale, '/')} class="btn-primary btn-lg" data-i18n="pages.backToTool">
          {tServer(locale, 'pages.backToTool')}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
